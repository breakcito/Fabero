# Configuracion de DESARROLLO (npm run dev).
# Se aplica solo en `vite dev` (mode=development); `npm run build` sigue
# usando el .env normal.

# API en ruta relativa: el proxy de vite.config.ts reenvia /api -> Herd.
# Asi el mismo dev server sirve para la PC y para el tablet (IP de la LAN)
# sin cambiar URLs: el proxy corre en la PC, que es la unica que llega a Herd
# (Herd solo escucha en 127.0.0.1).
VITE_API_URL=/api

# Dominio de Herd donde corre la API. Lo usa el proxy de vite.config.ts.
# (Sin /api: el prefijo lo agrega Laravel.)
VITE_API_HERD_URL=http://api-local-fabero.test

# Reverb: vacio => el socket se conecta al host desde el que se cargo la
# pagina (IP de la PC en la LAN). Con "localhost" el tablet apuntaria a si
# mismo y el websocket no conectaria.
VITE_REVERB_HOST=
